#!/usr/bin/env bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
IBUS_PID=""

cleanup() {
    if [ -n "$IBUS_PID" ] && kill -0 "$IBUS_PID" 2>/dev/null; then
        kill "$IBUS_PID" 2>/dev/null
        wait "$IBUS_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

DEFAULT_ARGS=""
if [ $# -eq 0 ]; then
    DEFAULT_ARGS=""
fi

# Kill any stale engine gracefully and wait for ibus-daemon to settle.
# SIGTERM (not SIGKILL) lets the engine clean up its D-Bus registration;
# a hard kill can leave ibus-daemon broken, requiring `ibus-daemon -rdx`.
if pkill -TERM -f "ibus_voice_engine.py" 2>/dev/null; then
    sleep 0.8   # give ibus-daemon time to notice the engine is gone
else
    sleep 0.1
fi

# Bail out early if ibus-daemon itself is not running.
if ! ibus address &>/dev/null; then
    echo "ERROR: ibus-daemon is not running. Start it with: ibus-daemon -rdx"
    exit 1
fi

if [ ! -f "$SCRIPT_DIR/.venv/bin/activate" ]; then
    echo "ERROR: .venv not found. Run: python3 -m venv --system-site-packages .venv && source .venv/bin/activate && pip install faster-whisper webrtcvad sherpa-onnx pyaudio numpy"
    exit 1
fi
source "$SCRIPT_DIR/.venv/bin/activate"

python -u "$SCRIPT_DIR/ibus_voice_engine.py" &
IBUS_PID=$!

echo "Starting IBus voice typing engine..."
for i in $(seq 1 20); do
    if ibus engine voice-typing 2>/dev/null; then
        echo "IBus voice-typing engine active"
        SOURCES=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null)
        if [[ "$SOURCES" != *"voice-typing"* ]]; then
            # Prepend voice-typing while preserving all existing input sources
            INNER="${SOURCES#[}"; INNER="${INNER%]}"
            if [ -n "$INNER" ]; then
                gsettings set org.gnome.desktop.input-sources sources "[('ibus', 'voice-typing'), ${INNER}]" 2>/dev/null
            else
                gsettings set org.gnome.desktop.input-sources sources "[('ibus', 'voice-typing')]" 2>/dev/null
            fi
        fi
        break
    fi
    sleep 0.5
done

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    echo "Bind F12 to ./voice-toggle for pause/resume on Wayland"
fi

exec python -u "$SCRIPT_DIR/enhanced-voice-typing.py" $DEFAULT_ARGS "$@"